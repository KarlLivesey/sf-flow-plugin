{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/FlowVersionsResult",
  "definitions": {
    "FlowVersionsResult": {
      "type": "object",
      "properties": {
        "apiName": {
          "type": "string"
        },
        "namespace": {
          "type": ["string", "null"]
        },
        "definitionId": {
          "type": "string"
        },
        "activeVersion": {
          "anyOf": [
            {
              "$ref": "#/definitions/FlowVersionNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "latestVersion": {
          "anyOf": [
            {
              "$ref": "#/definitions/FlowVersionNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "statuses": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowVersionStatusFilter"
          }
        },
        "createdBefore": {
          "type": ["string", "null"]
        },
        "createdAfter": {
          "type": ["string", "null"]
        },
        "sort": {
          "$ref": "#/definitions/FlowVersionSort"
        },
        "order": {
          "$ref": "#/definitions/FlowSortOrder"
        },
        "versions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowVersionSummary"
          }
        },
        "targetOrg": {
          "type": "string"
        }
      },
      "required": [
        "apiName",
        "namespace",
        "definitionId",
        "activeVersion",
        "latestVersion",
        "statuses",
        "createdBefore",
        "createdAfter",
        "sort",
        "order",
        "versions",
        "targetOrg"
      ],
      "additionalProperties": false
    },
    "FlowVersionNumber": {
      "type": "number"
    },
    "FlowVersionStatusFilter": {
      "type": "string",
      "enum": ["Active", "Draft", "InvalidDraft", "Obsolete"]
    },
    "FlowVersionSort": {
      "type": "string",
      "enum": ["version", "created", "modified"]
    },
    "FlowSortOrder": {
      "type": "string",
      "enum": ["asc", "desc"]
    },
    "FlowVersionSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "versionNumber": {
          "$ref": "#/definitions/FlowVersionNumber"
        },
        "status": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "processType": {
          "type": "string"
        },
        "createdDate": {
          "type": "string"
        },
        "lastModifiedDate": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        },
        "latest": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "versionNumber",
        "status",
        "label",
        "processType",
        "createdDate",
        "lastModifiedDate",
        "active",
        "latest"
      ],
      "additionalProperties": false
    }
  }
}
