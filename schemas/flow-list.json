{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/FlowListResult",
  "definitions": {
    "FlowListResult": {
      "type": "object",
      "properties": {
        "targetOrg": {
          "type": "string"
        },
        "filters": {
          "type": "object",
          "properties": {
            "apiNames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "namespaces": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "statuses": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["apiNames", "types", "namespaces", "statuses"],
          "additionalProperties": false
        },
        "sort": {
          "$ref": "#/definitions/FlowListSort"
        },
        "order": {
          "$ref": "#/definitions/FlowSortOrder"
        },
        "limit": {
          "type": ["number", "null"]
        },
        "definitions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowListEntry"
          }
        }
      },
      "required": ["targetOrg", "filters", "sort", "order", "limit", "definitions"],
      "additionalProperties": false
    },
    "FlowListSort": {
      "type": "string",
      "enum": ["active-version", "api-name", "label", "latest-version", "modified", "type"]
    },
    "FlowSortOrder": {
      "type": "string",
      "enum": ["asc", "desc"]
    },
    "FlowListEntry": {
      "type": "object",
      "properties": {
        "apiName": {
          "type": "string"
        },
        "namespace": {
          "type": ["string", "null"]
        },
        "definitionId": {
          "type": "string"
        },
        "label": {
          "type": ["string", "null"]
        },
        "processType": {
          "type": ["string", "null"]
        },
        "activeVersion": {
          "anyOf": [
            {
              "$ref": "#/definitions/FlowVersionNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "latestVersion": {
          "anyOf": [
            {
              "$ref": "#/definitions/FlowVersionNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": ["string", "null"]
        },
        "lastModifiedDate": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "apiName",
        "namespace",
        "definitionId",
        "label",
        "processType",
        "activeVersion",
        "latestVersion",
        "status",
        "lastModifiedDate"
      ],
      "additionalProperties": false
    },
    "FlowVersionNumber": {
      "type": "number"
    }
  }
}
