{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/FlowLintResult",
  "definitions": {
    "FlowLintResult": {
      "type": "object",
      "properties": {
        "apiName": {
          "type": "string"
        },
        "namespace": {
          "type": ["string", "null"]
        },
        "definitionId": {
          "type": ["string", "null"]
        },
        "requestedVersion": {
          "anyOf": [
            {
              "$ref": "#/definitions/FlowComparisonVersionSelector"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolvedVersion": {
          "anyOf": [
            {
              "$ref": "#/definitions/FlowVersionNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowLintFinding"
          }
        },
        "newFindings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowLintFinding"
          }
        },
        "baselineFindings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowLintFinding"
          }
        },
        "errors": {
          "type": "number"
        },
        "warnings": {
          "type": "number"
        },
        "newErrors": {
          "type": "number"
        },
        "newWarnings": {
          "type": "number"
        },
        "targetOrg": {
          "type": ["string", "null"]
        },
        "sourceFile": {
          "type": "string"
        }
      },
      "required": [
        "apiName",
        "namespace",
        "definitionId",
        "requestedVersion",
        "resolvedVersion",
        "status",
        "findings",
        "newFindings",
        "baselineFindings",
        "errors",
        "warnings",
        "newErrors",
        "newWarnings",
        "targetOrg"
      ],
      "additionalProperties": false
    },
    "FlowComparisonVersionSelector": {
      "anyOf": [
        {
          "type": "string",
          "const": "active"
        },
        {
          "type": "string",
          "const": "latest"
        },
        {
          "$ref": "#/definitions/FlowVersionNumber"
        }
      ]
    },
    "FlowVersionNumber": {
      "type": "number"
    },
    "FlowLintFinding": {
      "type": "object",
      "properties": {
        "fingerprint": {
          "type": "string"
        },
        "rule": {
          "$ref": "#/definitions/FlowLintRule"
        },
        "severity": {
          "$ref": "#/definitions/FlowLintSeverity"
        },
        "message": {
          "type": "string"
        },
        "element": {
          "type": ["string", "null"]
        },
        "path": {
          "type": ["string", "null"]
        }
      },
      "required": ["fingerprint", "rule", "severity", "message", "element", "path"],
      "additionalProperties": false
    },
    "FlowLintRule": {
      "type": "string",
      "enum": [
        "dml-inside-loop",
        "hard-coded-id",
        "inactive-subflow",
        "missing-fault-path",
        "missing-subflow",
        "unconnected-element",
        "unused-resource"
      ]
    },
    "FlowLintSeverity": {
      "type": "string",
      "enum": ["error", "warning"]
    }
  }
}
