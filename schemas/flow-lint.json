{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/LintCommandResult",
  "definitions": {
    "LintCommandResult": {
      "anyOf": [
        {
          "$ref": "#/definitions/FlowLintDirectoryResult"
        },
        {
          "$ref": "#/definitions/FlowLintResult"
        }
      ]
    },
    "FlowLintDirectoryResult": {
      "type": "object",
      "properties": {
        "sourceDirectory": {
          "type": "string"
        },
        "flows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowLintResult"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowLintFinding"
          }
        },
        "newFindings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowLintFinding"
          }
        },
        "baselineFindings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowLintFinding"
          }
        },
        "errors": {
          "type": "number"
        },
        "warnings": {
          "type": "number"
        },
        "newErrors": {
          "type": "number"
        },
        "newWarnings": {
          "type": "number"
        }
      },
      "required": [
        "sourceDirectory",
        "flows",
        "findings",
        "newFindings",
        "baselineFindings",
        "errors",
        "warnings",
        "newErrors",
        "newWarnings"
      ],
      "additionalProperties": false
    },
    "FlowLintResult": {
      "type": "object",
      "properties": {
        "apiName": {
          "type": "string"
        },
        "namespace": {
          "type": ["string", "null"]
        },
        "definitionId": {
          "type": ["string", "null"]
        },
        "requestedVersion": {
          "anyOf": [
            {
              "$ref": "#/definitions/FlowComparisonVersionSelector"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolvedVersion": {
          "anyOf": [
            {
              "$ref": "#/definitions/FlowVersionNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowLintFinding"
          }
        },
        "newFindings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowLintFinding"
          }
        },
        "baselineFindings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowLintFinding"
          }
        },
        "errors": {
          "type": "number"
        },
        "warnings": {
          "type": "number"
        },
        "newErrors": {
          "type": "number"
        },
        "newWarnings": {
          "type": "number"
        },
        "targetOrg": {
          "type": ["string", "null"]
        },
        "sourceFile": {
          "type": "string"
        }
      },
      "required": [
        "apiName",
        "namespace",
        "definitionId",
        "requestedVersion",
        "resolvedVersion",
        "status",
        "findings",
        "newFindings",
        "baselineFindings",
        "errors",
        "warnings",
        "newErrors",
        "newWarnings",
        "targetOrg"
      ],
      "additionalProperties": false
    },
    "FlowComparisonVersionSelector": {
      "anyOf": [
        {
          "type": "string",
          "const": "active"
        },
        {
          "type": "string",
          "const": "latest"
        },
        {
          "$ref": "#/definitions/FlowVersionNumber"
        }
      ]
    },
    "FlowVersionNumber": {
      "type": "number"
    },
    "FlowLintFinding": {
      "type": "object",
      "properties": {
        "fingerprint": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/FlowLintSeverity"
        },
        "message": {
          "type": "string"
        },
        "element": {
          "type": ["string", "null"]
        },
        "path": {
          "type": ["string", "null"]
        },
        "analyzerSeverity": {
          "type": "number"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowLintLocation"
          }
        }
      },
      "required": ["fingerprint", "rule", "severity", "message", "element", "path"],
      "additionalProperties": false
    },
    "FlowLintSeverity": {
      "type": "string",
      "enum": ["error", "warning"]
    },
    "FlowLintLocation": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "startLine": {
          "type": "number"
        },
        "startColumn": {
          "type": "number"
        },
        "endLine": {
          "type": ["number", "null"]
        },
        "endColumn": {
          "type": ["number", "null"]
        },
        "primary": {
          "type": "boolean"
        }
      },
      "required": ["file", "startLine", "startColumn", "endLine", "endColumn", "primary"],
      "additionalProperties": false
    }
  }
}
