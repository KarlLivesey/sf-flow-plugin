{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/FlowSearchResult",
  "definitions": {
    "FlowSearchResult": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "flowsScanned": {
          "type": "number"
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowSearchMatch"
          }
        }
      },
      "required": ["query", "kind", "flowsScanned", "matches"],
      "additionalProperties": false
    },
    "FlowSearchMatch": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "element": {
          "type": ["string", "null"]
        },
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "flow": {
          "type": "string"
        },
        "version": {
          "type": ["number", "null"]
        }
      },
      "required": ["element", "flow", "key", "path", "value", "version"],
      "additionalProperties": false
    }
  }
}
