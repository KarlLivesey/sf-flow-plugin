{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/FlowRunResult",
  "definitions": {
    "FlowRunResult": {
      "type": "object",
      "properties": {
        "apiName": {
          "type": "string"
        },
        "namespace": {
          "type": ["string", "null"]
        },
        "definitionId": {
          "type": "string"
        },
        "version": {
          "$ref": "#/definitions/FlowVersionNumber"
        },
        "processType": {
          "type": "string"
        },
        "production": {
          "type": "boolean"
        },
        "dryRun": {
          "type": "boolean"
        },
        "durationMilliseconds": {
          "type": "number"
        },
        "successful": {
          "type": ["boolean", "null"]
        },
        "invocations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowInvocation"
          }
        },
        "targetOrg": {
          "type": "string"
        },
        "debug": {
          "$ref": "#/definitions/FlowRunDebug"
        }
      },
      "required": [
        "apiName",
        "namespace",
        "definitionId",
        "version",
        "processType",
        "production",
        "dryRun",
        "durationMilliseconds",
        "successful",
        "invocations",
        "targetOrg"
      ],
      "additionalProperties": false
    },
    "FlowVersionNumber": {
      "type": "number"
    },
    "FlowInvocation": {
      "type": "object",
      "properties": {
        "interviewId": {
          "type": ["string", "null"]
        },
        "version": {
          "$ref": "#/definitions/FlowVersionNumber"
        },
        "success": {
          "type": ["boolean", "null"]
        },
        "inputs": {
          "$ref": "#/definitions/JsonObject"
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/JsonValue"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowInvocationError"
          }
        },
        "executed": {
          "type": "boolean"
        }
      },
      "required": ["interviewId", "version", "success", "inputs", "outputs", "errors", "executed"],
      "additionalProperties": false
    },
    "JsonObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/JsonValue"
      }
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/definitions/JsonPrimitive"
        },
        {
          "$ref": "#/definitions/JsonObject"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JsonValue"
          }
        }
      ]
    },
    "JsonPrimitive": {
      "type": ["boolean", "null", "number", "string"]
    },
    "FlowInvocationError": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "code": {
          "type": ["string", "null"]
        }
      },
      "required": ["message", "code"],
      "additionalProperties": false
    },
    "FlowRunDebug": {
      "type": "object",
      "properties": {
        "correlationId": {
          "type": "string"
        },
        "databaseChangesRolledBack": {
          "type": "boolean"
        },
        "valuesShown": {
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/definitions/FlowDebugError"
            },
            {
              "type": "null"
            }
          ]
        },
        "debugLog": {
          "$ref": "#/definitions/FlowDebugLogRecord"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowDebugEvent"
          }
        }
      },
      "required": ["correlationId", "databaseChangesRolledBack", "valuesShown", "error", "debugLog", "events"],
      "additionalProperties": false
    },
    "FlowDebugError": {
      "type": "object",
      "properties": {
        "type": {
          "type": ["string", "null"]
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["type", "message"],
      "additionalProperties": false
    },
    "FlowDebugLogRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "startTime": {
          "type": "string"
        },
        "durationMilliseconds": {
          "type": "number"
        },
        "logLength": {
          "type": "number"
        }
      },
      "required": ["id", "status", "operation", "startTime", "durationMilliseconds", "logLength"],
      "additionalProperties": false
    },
    "FlowDebugEvent": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "number"
        },
        "timestamp": {
          "type": "string"
        },
        "event": {
          "type": "string"
        },
        "interviewId": {
          "type": ["string", "null"]
        },
        "elementType": {
          "type": ["string", "null"]
        },
        "elementName": {
          "type": ["string", "null"]
        },
        "detail": {
          "type": ["string", "null"]
        }
      },
      "required": ["sequence", "timestamp", "event", "interviewId", "elementType", "elementName", "detail"],
      "additionalProperties": false
    }
  }
}
