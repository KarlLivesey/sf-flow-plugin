{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/FlowMetricsResult",
  "definitions": {
    "FlowMetricsResult": {
      "type": "object",
      "properties": {
        "apiName": {
          "type": "string"
        },
        "namespace": {
          "type": ["string", "null"]
        },
        "requestedVersion": {
          "$ref": "#/definitions/FlowComparisonVersionSelector"
        },
        "resolvedVersion": {
          "type": "number"
        },
        "subflowVersion": {
          "$ref": "#/definitions/FlowSubflowVersionSelector"
        },
        "recursive": {
          "type": "boolean"
        },
        "maxDepth": {
          "type": "number"
        },
        "totals": {
          "$ref": "#/definitions/FlowMetricCounts"
        },
        "referencedObjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowMetricEntry"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowTraversalWarning"
          }
        },
        "targetOrg": {
          "type": "string"
        }
      },
      "required": [
        "apiName",
        "namespace",
        "requestedVersion",
        "resolvedVersion",
        "subflowVersion",
        "recursive",
        "maxDepth",
        "totals",
        "referencedObjects",
        "flows",
        "warnings",
        "targetOrg"
      ],
      "additionalProperties": false
    },
    "FlowComparisonVersionSelector": {
      "anyOf": [
        {
          "type": "string",
          "const": "active"
        },
        {
          "type": "string",
          "const": "latest"
        },
        {
          "$ref": "#/definitions/FlowVersionNumber"
        }
      ]
    },
    "FlowVersionNumber": {
      "type": "number"
    },
    "FlowSubflowVersionSelector": {
      "type": "string",
      "enum": ["active", "latest"]
    },
    "FlowMetricCounts": {
      "type": "object",
      "properties": {
        "executableElements": {
          "type": "number"
        },
        "decisions": {
          "type": "number"
        },
        "decisionOutcomes": {
          "type": "number"
        },
        "loops": {
          "type": "number"
        },
        "maximumLoopNesting": {
          "type": "number"
        },
        "dmlElements": {
          "type": "number"
        },
        "dmlInsideLoops": {
          "type": "number"
        },
        "apexActions": {
          "type": "number"
        },
        "subflows": {
          "type": "number"
        },
        "maximumPathDepth": {
          "type": "number"
        },
        "faultCapableElements": {
          "type": "number"
        },
        "faultConnectedElements": {
          "type": "number"
        },
        "variables": {
          "type": "number"
        },
        "formulas": {
          "type": "number"
        },
        "unusedResources": {
          "type": "number"
        },
        "maximumFanIn": {
          "type": "number"
        },
        "maximumFanOut": {
          "type": "number"
        },
        "unreachableElements": {
          "type": "number"
        }
      },
      "required": [
        "executableElements",
        "decisions",
        "decisionOutcomes",
        "loops",
        "maximumLoopNesting",
        "dmlElements",
        "dmlInsideLoops",
        "apexActions",
        "subflows",
        "maximumPathDepth",
        "faultCapableElements",
        "faultConnectedElements",
        "variables",
        "formulas",
        "unusedResources",
        "maximumFanIn",
        "maximumFanOut",
        "unreachableElements"
      ],
      "additionalProperties": false
    },
    "FlowMetricEntry": {
      "type": "object",
      "properties": {
        "executableElements": {
          "type": "number"
        },
        "decisions": {
          "type": "number"
        },
        "decisionOutcomes": {
          "type": "number"
        },
        "loops": {
          "type": "number"
        },
        "maximumLoopNesting": {
          "type": "number"
        },
        "dmlElements": {
          "type": "number"
        },
        "dmlInsideLoops": {
          "type": "number"
        },
        "apexActions": {
          "type": "number"
        },
        "subflows": {
          "type": "number"
        },
        "maximumPathDepth": {
          "type": "number"
        },
        "faultCapableElements": {
          "type": "number"
        },
        "faultConnectedElements": {
          "type": "number"
        },
        "variables": {
          "type": "number"
        },
        "formulas": {
          "type": "number"
        },
        "unusedResources": {
          "type": "number"
        },
        "maximumFanIn": {
          "type": "number"
        },
        "maximumFanOut": {
          "type": "number"
        },
        "unreachableElements": {
          "type": "number"
        },
        "apiName": {
          "type": "string"
        },
        "namespace": {
          "type": ["string", "null"]
        },
        "version": {
          "type": "number"
        },
        "depth": {
          "type": "number"
        },
        "faultPathCoverage": {
          "type": ["number", "null"]
        },
        "referencedObjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unusedResourceNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unreachableElementNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "apexActions",
        "apiName",
        "decisionOutcomes",
        "decisions",
        "depth",
        "dmlElements",
        "dmlInsideLoops",
        "executableElements",
        "faultCapableElements",
        "faultConnectedElements",
        "faultPathCoverage",
        "formulas",
        "loops",
        "maximumFanIn",
        "maximumFanOut",
        "maximumLoopNesting",
        "maximumPathDepth",
        "namespace",
        "referencedObjects",
        "subflows",
        "unreachableElementNames",
        "unreachableElements",
        "unusedResourceNames",
        "unusedResources",
        "variables",
        "version"
      ],
      "additionalProperties": false
    },
    "FlowTraversalWarning": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/definitions/FlowTraversalWarningKind"
        },
        "flowName": {
          "type": "string"
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["kind", "flowName", "path"],
      "additionalProperties": false
    },
    "FlowTraversalWarningKind": {
      "type": "string",
      "enum": ["depth-limit", "missing-subflow", "subflow-version-fallback", "missing-subflow-version"]
    }
  }
}
