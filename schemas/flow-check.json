{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/FlowCheckResult",
  "definitions": {
    "FlowCheckResult": {
      "type": "object",
      "properties": {
        "apiNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requestedVersion": {
          "anyOf": [
            {
              "$ref": "#/definitions/FlowComparisonVersionSelector"
            },
            {
              "type": "null"
            }
          ]
        },
        "subflowVersion": {
          "$ref": "#/definitions/FlowSubflowVersionSelector"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowCheckKind"
          }
        },
        "excludedChecks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowCheckKind"
          }
        },
        "recursive": {
          "type": "boolean"
        },
        "maxDepth": {
          "type": "number"
        },
        "allowTruncated": {
          "type": "boolean"
        },
        "flows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowCheckEntry"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowCheckFinding"
          }
        },
        "errors": {
          "type": "number"
        },
        "warnings": {
          "type": "number"
        },
        "targetOrg": {
          "type": ["string", "null"]
        },
        "sourceFile": {
          "type": "string"
        },
        "sourceDirectory": {
          "type": "string"
        }
      },
      "required": [
        "apiNames",
        "requestedVersion",
        "subflowVersion",
        "checks",
        "excludedChecks",
        "recursive",
        "maxDepth",
        "allowTruncated",
        "flows",
        "findings",
        "errors",
        "warnings",
        "targetOrg"
      ],
      "additionalProperties": false
    },
    "FlowComparisonVersionSelector": {
      "anyOf": [
        {
          "type": "string",
          "const": "active"
        },
        {
          "type": "string",
          "const": "latest"
        },
        {
          "$ref": "#/definitions/FlowVersionNumber"
        }
      ]
    },
    "FlowVersionNumber": {
      "type": "number"
    },
    "FlowSubflowVersionSelector": {
      "type": "string",
      "enum": ["active", "latest"]
    },
    "FlowCheckKind": {
      "type": "string",
      "enum": ["dependencies", "lint", "metrics", "subflows", "versions"]
    },
    "FlowCheckEntry": {
      "type": "object",
      "properties": {
        "apiName": {
          "type": "string"
        },
        "namespace": {
          "type": ["string", "null"]
        },
        "resolvedVersion": {
          "type": ["number", "null"]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowCheckKind"
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowInputOutputContract"
          }
        },
        "metrics": {
          "anyOf": [
            {
              "$ref": "#/definitions/FlowMetricsResult"
            },
            {
              "$ref": "#/definitions/FlowSourceMetricsResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowCheckFinding"
          }
        },
        "errors": {
          "type": "number"
        },
        "warnings": {
          "type": "number"
        }
      },
      "required": [
        "apiName",
        "namespace",
        "resolvedVersion",
        "checks",
        "contracts",
        "metrics",
        "findings",
        "errors",
        "warnings"
      ],
      "additionalProperties": false
    },
    "FlowInputOutputContract": {
      "type": "object",
      "properties": {
        "apiName": {
          "type": "string"
        },
        "namespace": {
          "type": ["string", "null"]
        },
        "version": {
          "type": ["number", "null"]
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowVariableSummary"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowVariableSummary"
          }
        }
      },
      "required": ["apiName", "namespace", "version", "inputs", "outputs"],
      "additionalProperties": false
    },
    "FlowVariableSummary": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "dataType": {
          "type": "string"
        },
        "objectType": {
          "type": ["string", "null"]
        },
        "apexClass": {
          "type": ["string", "null"]
        },
        "collection": {
          "type": "boolean"
        },
        "input": {
          "type": "boolean"
        },
        "output": {
          "type": "boolean"
        },
        "description": {
          "type": ["string", "null"]
        }
      },
      "required": ["name", "dataType", "objectType", "apexClass", "collection", "input", "output", "description"],
      "additionalProperties": false
    },
    "FlowMetricsResult": {
      "type": "object",
      "properties": {
        "apiName": {
          "type": "string"
        },
        "namespace": {
          "type": ["string", "null"]
        },
        "requestedVersion": {
          "$ref": "#/definitions/FlowComparisonVersionSelector"
        },
        "resolvedVersion": {
          "type": "number"
        },
        "subflowVersion": {
          "$ref": "#/definitions/FlowSubflowVersionSelector"
        },
        "recursive": {
          "type": "boolean"
        },
        "maxDepth": {
          "type": "number"
        },
        "totals": {
          "$ref": "#/definitions/FlowMetricCounts"
        },
        "referencedObjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowMetricEntry"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowTraversalWarning"
          }
        },
        "targetOrg": {
          "type": "string"
        }
      },
      "required": [
        "apiName",
        "namespace",
        "requestedVersion",
        "resolvedVersion",
        "subflowVersion",
        "recursive",
        "maxDepth",
        "totals",
        "referencedObjects",
        "flows",
        "warnings",
        "targetOrg"
      ],
      "additionalProperties": false
    },
