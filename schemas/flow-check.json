        "subflows",
        "maximumPathDepthUpperBound",
        "faultCapableElements",
        "faultConnectedElements",
        "variables",
        "formulas",
        "unusedResources",
        "maximumFanIn",
        "maximumFanOut",
        "unreachableElements"
