{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/FlowSnapshotResult",
  "definitions": {
    "FlowSnapshotResult": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "createdAt": {
          "type": "string"
        },
        "targetOrg": {
          "type": "string"
        },
        "versionSelector": {
          "$ref": "#/definitions/FlowComparisonVersionSelector"
        },
        "selection": {
          "type": "object",
          "properties": {
            "apiNames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "namespace": {
              "type": ["string", "null"]
            }
          },
          "required": ["apiNames", "namespace"],
          "additionalProperties": false
        },
        "flows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowSnapshotEntry"
          }
        }
      },
      "required": ["schemaVersion", "createdAt", "targetOrg", "versionSelector", "selection", "flows"],
      "additionalProperties": false
    },
    "FlowComparisonVersionSelector": {
      "anyOf": [
        {
          "type": "string",
          "const": "active"
        },
        {
          "type": "string",
          "const": "latest"
        },
        {
          "$ref": "#/definitions/FlowVersionNumber"
        }
      ]
    },
    "FlowVersionNumber": {
      "type": "number"
    },
    "FlowSnapshotEntry": {
      "type": "object",
      "properties": {
        "apiName": {
          "type": "string"
        },
        "namespace": {
          "type": ["string", "null"]
        },
        "version": {
          "type": "number"
        },
        "status": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": ["apiName", "namespace", "version", "status", "file", "sha256"],
      "additionalProperties": false
    }
  }
}
